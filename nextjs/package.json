{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "_gen:types": "cross-env-shell \"pocketbase-typegen --url $POCKETBASE_URL --email $ADMIN_EMAIL --password $ADMIN_PASSWORD --out types/pocketbase-types.ts\"",
    "gen:types": "dotenv -e .env -- npm run _gen:types",
    "dev": "npm run gen:types && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@react-spring/web": "^9.7.5",
    "@tanstack/react-query": "^5.66.0",
    "@use-gesture/react": "^10.3.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "next": "^15.1.6",
    "pocketbase": "^0.21.5",
    "pocketbase-typegen": "^1.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-tinder-card": "^1.6.4",
    "use-gesture": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.14",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
