{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "_gen:types": "cross-env-shell \"pocketbase-typegen --url $POCKETBASE_URL --email $ADMIN_EMAIL --password $ADMIN_PASSWORD --out types/pocketbase-types.ts\"",
    "gen:types": "dotenv -e .env -- npm run _gen:types",
    "dev": "npm run gen:types && next dev -p 4001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@react-spring/web": "^10.0.3",
    "@tanstack/react-query": "^5.90.21",
    "@use-gesture/react": "^10.3.1",
    "autoprefixer": "^10.4.24",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.34.0",
    "next": "^16.1.6",
    "pocketbase": "^0.26.8",
    "pocketbase-typegen": "^1.3.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-tinder-card": "^1.6.4",
    "use-gesture": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10",
    "eslint-config-next": "16.1.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5"
  }
}
